# Clé API Resend (https://resend.com/api-keys) — obligatoire pour le formulaire de contact
RESEND_API_KEY=

# Destinataire des messages (par défaut : l'email de data/personal.ts)
CONTACT_TO=

# Expéditeur — doit appartenir à un domaine vérifié dans Resend, donc à un domaine
# personnel (un sous-domaine vercel.app ne peut pas être vérifié).
# Par défaut : onboarding@resend.dev, qui ne délivre qu'au propriétaire du compte Resend.
CONTACT_FROM="Portfolio Contact <contact@votre-domaine.com>"
