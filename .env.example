# Clé API Resend (https://resend.com/api-keys) — obligatoire pour le formulaire de contact
RESEND_API_KEY=

# Destinataire des messages (par défaut : l'email de data/personal.ts)
CONTACT_TO=

# Expéditeur — doit appartenir à un domaine vérifié dans Resend
# (par défaut : onboarding@resend.dev, qui ne délivre qu'au propriétaire du compte)
CONTACT_FROM="Portfolio Contact <contact@ibrahimadev.com>"
